{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.RenderedCompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ],
    "Enrich": ["FromLogContext", "WithMachineName", "WithProcessId"]
  },
  "Jwt": {
    "Issuer": "oficina-auth",
    "Audience": "oficina-api",
    "Secret": ""
  },
  "Mensageria": {
    "Transporte": "InMemory",
    "PrefixoAmbiente": "local",
    "Regiao": "us-east-1"
  },
  "Dynamo": {
    "NomeTabela": "oficina-billing-local",
    "CriarTabelaSeAusente": false
  },
  "Pagamento": {
    "Modo": "Simulado"
  },
  "MercadoPago": {
    "UrlBase": "https://api.mercadopago.com"
  },
  "AllowedHosts": "*"
}
